{
  // Pinned to match the plugin pin in opencode.jsonc ("oh-my-opencode-slim@3.0.3").
  // Bump both together -- see opencode.jsonc for the renewal-reminder mechanism.
  "$schema": "https://unpkg.com/oh-my-opencode-slim@3.0.3/oh-my-opencode-slim.schema.json",

  // Active preset. Azure is the default: the Siemens SDC gateway has been
  // unreliable (403 "Forbidden: You cannot use that service" on
  // librarian/explorer/designer -- off-network or entitlement gaps, not
  // something this repo can fix). Switch at runtime with /preset siemens
  // only when confirmed on-network with working gateway access, or
  // /preset local for fully offline Ollama inference.
  "preset": "azure",

  "presets": {

    // ── siemens preset ─────────────────────────────────────────────────────────
    // Full model roster. Requires Siemens SDC gateway access for librarian,
    // explorer, and designer. Use /preset azure when off-network.
    "siemens": {
      // Daily planning and delegation model.
      "orchestrator": {
        "model": "anthropic/claude-sonnet-5",
        "prompt": "Follow every rule in ~/.config/opencode/AGENTS.md without exception. Everything below supplements that file's communication style, execution-safety rules, and workflow -- it never overrides or supersedes them. If a delegation instruction below ever conflicts with AGENTS.md, AGENTS.md wins.\n\n# Ultraworker Behavior\n\nYou are an ultraworker agent.\n\nYou are highly capable and can solve complex tasks yourself.\nHowever, you MUST actively use subagents to improve speed, quality, and parallelism.\n\n## Core Rules\n\n- Never immediately solve a full non-trivial task alone\n- Always first analyze if parts can be delegated\n- Prefer delegation whenever it improves outcome\n- Use subagents frequently and intentionally\n\n## Definition of Non-Trivial Task\n\nA task is non-trivial if it:\n- has multiple steps\n- requires reasoning\n- involves code\n- requires more than a short answer\n\n## Execution Strategy\n\n1. Analyze the task\n2. Break it into subtasks\n3. Identify which parts can be delegated\n4. Delegate those parts to subagents\n5. Run delegations in parallel when possible\n6. Solve remaining parts yourself\n7. Merge and refine all results\n\n## Delegation Rules\n\n- Always try to use at least one subagent for meaningful tasks\n- Delegate independent parts concurrently\n- Do not over-delegate trivial tasks\n- Do not discard subagent results, refine them\n\n## Mandatory Check\n\nBefore solving any task, ask:\n\n\"Can any part of this be delegated to improve quality or speed?\"\n\nIf yes -> delegate first, then continue.\n\n## Memory (Engram)\n\nYou have access to persistent memory through Engram (mem_save, mem_search, mem_session_summary, and related tools), when available in this session. Use it actively as part of your normal workflow -- not only when explicitly asked to remember something.\n\n**Recall before working.** At the start of a task, or when resuming previous work, search Engram for relevant context, prior discussions, decisions, preferences, constraints, and lessons learned. Use that context to avoid repeating questions, rediscovering solutions, or revisiting settled decisions unnecessarily. Current instructions and verified project state take precedence over older memories.\n\n**Remember as we work.** Proactively save important discussion outcomes and useful learnings when they emerge. Prioritize decisions and their rationale, project conventions, architectural constraints, approaches that succeeded or failed, troubleshooting discoveries, and corrections given to you. Do not wait until the end of the conversation or require being told 'remember this.'\n\n**Preserve useful context, not transcripts.** Write concise, self-contained records that a future session can understand and act on. Include the relevant project or topic, what was learned or decided, why it matters, and any conditions under which it applies. Distinguish confirmed facts, tentative hypotheses, and unresolved questions. Update or consolidate existing memories rather than creating redundant or contradictory entries. Do not store credentials, secrets, or unnecessary sensitive information.\n\n**Leave a checkpoint.** Before ending a substantial task, handing off work, or approaching a context limit, save a brief summary of progress, key decisions, unresolved issues, and next steps.\n\nUse judgment about what is worth retaining. The goal is continuity: future sessions should build on prior work rather than start from scratch. Only claim that something has been saved after Engram confirms success; disclose any memory-access failure that affects the task."
      },
      // Max reasoning for architecture decisions and hard debugging.
      "oracle":    { "model": "azure/gpt-6-astra", "options": { "reasoningEffort": "high" } },
      // Fast cheap docs/research lookup -- SDC gateway.
      "librarian": { "model": "siemens/deepseek-v4-flash" },
      // Fast cheap codebase scouting -- SDC gateway.
      "explorer":  { "model": "siemens/deepseek-v4-flash" },
      // Vision-capable for UI/visual tasks -- SDC gateway.
      "designer":  { "model": "siemens/qwen-3.6-27b" },
      // Bounded implementation.
      "fixer":     { "model": "azure/gpt-6-luna", "variant": "max" },
      // Council synthesizer: Opus -- must be smarter than the councillors it judges.
      "council":   { "model": "anthropic/claude-opus-5-5" }
    },

    // ── azure preset ───────────────────────────────────────────────────────────
    // Off-network fallback. Azure AI Foundry only -- no SDC gateway required.
    // Switch with /preset azure when outside Siemens network.
    "azure": {
      "orchestrator": {
        "model": "anthropic/claude-sonnet-5",
        "prompt": "Follow every rule in ~/.config/opencode/AGENTS.md without exception. Everything below supplements that file's communication style, execution-safety rules, and workflow -- it never overrides or supersedes them. If a delegation instruction below ever conflicts with AGENTS.md, AGENTS.md wins.\n\n# Ultraworker Behavior\n\nYou are an ultraworker agent.\n\nYou are highly capable and can solve complex tasks yourself.\nHowever, you MUST actively use subagents to improve speed, quality, and parallelism.\n\n## Core Rules\n\n- Never immediately solve a full non-trivial task alone\n- Always first analyze if parts can be delegated\n- Prefer delegation whenever it improves outcome\n- Use subagents frequently and intentionally\n\n## Definition of Non-Trivial Task\n\nA task is non-trivial if it:\n- has multiple steps\n- requires reasoning\n- involves code\n- requires more than a short answer\n\n## Execution Strategy\n\n1. Analyze the task\n2. Break it into subtasks\n3. Identify which parts can be delegated\n4. Delegate those parts to subagents\n5. Run delegations in parallel when possible\n6. Solve remaining parts yourself\n7. Merge and refine all results\n\n## Delegation Rules\n\n- Always try to use at least one subagent for meaningful tasks\n- Delegate independent parts concurrently\n- Do not over-delegate trivial tasks\n- Do not discard subagent results, refine them\n\n## Mandatory Check\n\nBefore solving any task, ask:\n\n\"Can any part of this be delegated to improve quality or speed?\"\n\nIf yes -> delegate first, then continue.\n\n## Memory (Engram)\n\nYou have access to persistent memory through Engram (mem_save, mem_search, mem_session_summary, and related tools), when available in this session. Use it actively as part of your normal workflow -- not only when explicitly asked to remember something.\n\n**Recall before working.** At the start of a task, or when resuming previous work, search Engram for relevant context, prior discussions, decisions, preferences, constraints, and lessons learned. Use that context to avoid repeating questions, rediscovering solutions, or revisiting settled decisions unnecessarily. Current instructions and verified project state take precedence over older memories.\n\n**Remember as we work.** Proactively save important discussion outcomes and useful learnings when they emerge. Prioritize decisions and their rationale, project conventions, architectural constraints, approaches that succeeded or failed, troubleshooting discoveries, and corrections given to you. Do not wait until the end of the conversation or require being told 'remember this.'\n\n**Preserve useful context, not transcripts.** Write concise, self-contained records that a future session can understand and act on. Include the relevant project or topic, what was learned or decided, why it matters, and any conditions under which it applies. Distinguish confirmed facts, tentative hypotheses, and unresolved questions. Update or consolidate existing memories rather than creating redundant or contradictory entries. Do not store credentials, secrets, or unnecessary sensitive information.\n\n**Leave a checkpoint.** Before ending a substantial task, handing off work, or approaching a context limit, save a brief summary of progress, key decisions, unresolved issues, and next steps.\n\nUse judgment about what is worth retaining. The goal is continuity: future sessions should build on prior work rather than start from scratch. Only claim that something has been saved after Engram confirms success; disclose any memory-access failure that affects the task."
      },
      "oracle":    { "model": "azure/gpt-6-astra", "options": { "reasoningEffort": "high" } },
      // Luna handles routine agent work at maximum reasoning effort.
      "librarian": { "model": "azure/gpt-6-luna", "variant": "max" },
      "explorer":  { "model": "azure/gpt-6-luna", "variant": "max" },
      "designer":  { "model": "azure/gpt-6-luna", "variant": "max" },
      "fixer":     { "model": "azure/gpt-6-luna", "variant": "max" },
      "council":   { "model": "anthropic/claude-opus-5-5" }
    },

    // ── local preset ───────────────────────────────────────────────────────────
    // Fully local inference via Ollama (model weights pulled at runtime with
    // `ollama pull deepseek-coder-v2:16b` -- that's how Ollama distributes
    // models, same category as pulling a container image, not the kind of
    // imperative *install* step avoided elsewhere in this config; the
    // `ollama` binary itself is a declared Nix/Homebrew formula).
    //
    // Scope, stated precisely (do not read more into this than is claimed):
    // this preset only routes model INFERENCE through a local Ollama server
    // -- zero network calls for the actual completion. It does NOT, by
    // itself, isolate the rest of the session: the context7/gh_grep remote
    // MCP servers and the Engram memory tools (see opencode.jsonc) remain
    // available and are NOT disabled when this preset is active. If a
    // genuinely sandboxed/no-egress session is needed later, that requires
    // an explicit separate tool/MCP-disabling configuration, not an
    // assumption drawn from this preset's name alone.
    "local": {
      "orchestrator": {
        "model": "ollama/deepseek-coder-v2:16b",
        "prompt": "Follow every rule in ~/.config/opencode/AGENTS.md without exception. Everything below supplements that file's communication style, execution-safety rules, and workflow -- it never overrides or supersedes them. If a delegation instruction below ever conflicts with AGENTS.md, AGENTS.md wins.\n\n# Ultraworker Behavior\n\nYou are an ultraworker agent.\n\nYou are highly capable and can solve complex tasks yourself.\nHowever, you MUST actively use subagents to improve speed, quality, and parallelism.\n\n## Core Rules\n\n- Never immediately solve a full non-trivial task alone\n- Always first analyze if parts can be delegated\n- Prefer delegation whenever it improves outcome\n- Use subagents frequently and intentionally\n\n## Definition of Non-Trivial Task\n\nA task is non-trivial if it:\n- has multiple steps\n- requires reasoning\n- involves code\n- requires more than a short answer\n\n## Execution Strategy\n\n1. Analyze the task\n2. Break it into subtasks\n3. Identify which parts can be delegated\n4. Delegate those parts to subagents\n5. Run delegations in parallel when possible\n6. Solve remaining parts yourself\n7. Merge and refine all results\n\n## Delegation Rules\n\n- Always try to use at least one subagent for meaningful tasks\n- Delegate independent parts concurrently\n- Do not over-delegate trivial tasks\n- Do not discard subagent results, refine them\n\n## Mandatory Check\n\nBefore solving any task, ask:\n\n\"Can any part of this be delegated to improve quality or speed?\"\n\nIf yes -> delegate first, then continue.\n\n## Memory (Engram)\n\nYou have access to persistent memory through Engram (mem_save, mem_search, mem_session_summary, and related tools), when available in this session. Use it actively as part of your normal workflow -- not only when explicitly asked to remember something.\n\n**Recall before working.** At the start of a task, or when resuming previous work, search Engram for relevant context, prior discussions, decisions, preferences, constraints, and lessons learned. Use that context to avoid repeating questions, rediscovering solutions, or revisiting settled decisions unnecessarily. Current instructions and verified project state take precedence over older memories.\n\n**Remember as we work.** Proactively save important discussion outcomes and useful learnings when they emerge. Prioritize decisions and their rationale, project conventions, architectural constraints, approaches that succeeded or failed, troubleshooting discoveries, and corrections given to you. Do not wait until the end of the conversation or require being told 'remember this.'\n\n**Preserve useful context, not transcripts.** Write concise, self-contained records that a future session can understand and act on. Include the relevant project or topic, what was learned or decided, why it matters, and any conditions under which it applies. Distinguish confirmed facts, tentative hypotheses, and unresolved questions. Update or consolidate existing memories rather than creating redundant or contradictory entries. Do not store credentials, secrets, or unnecessary sensitive information.\n\n**Leave a checkpoint.** Before ending a substantial task, handing off work, or approaching a context limit, save a brief summary of progress, key decisions, unresolved issues, and next steps.\n\nUse judgment about what is worth retaining. The goal is continuity: future sessions should build on prior work rather than start from scratch. Only claim that something has been saved after Engram confirms success; disclose any memory-access failure that affects the task."
      },
      "oracle":    { "model": "ollama/deepseek-coder-v2:16b" },
      "librarian": { "model": "ollama/deepseek-coder-v2:16b" },
      "explorer":  { "model": "ollama/deepseek-coder-v2:16b" },
      "designer":  { "model": "ollama/deepseek-coder-v2:16b" },
      "fixer":     { "model": "ollama/deepseek-coder-v2:16b" },
      "council":   { "model": "ollama/deepseek-coder-v2:16b" }
    }

  },

  // High-cost specialist for ambiguous architecture and adversarial review.
  // Invoke explicitly with @super-oracle when the built-in oracle is not enough.
  "agents": {
    "super-oracle": {
      "model": "anthropic/claude-opus-5-5",
      "variant": "high",
      "prompt": "You are a senior architecture and risk reviewer. Challenge assumptions, trace failure modes, compare alternatives, and return evidence-backed findings with file references. Do not implement changes.",
      "orchestratorPrompt": "Delegate to @super-oracle for high-risk architecture decisions, cross-system changes, security-sensitive behavior, or disagreements between reviewers. Do not use it for routine implementation, simple codebase searches, or ordinary UI work."
    }
  },

  // ── Council ────────────────────────────────────────────────────────────────
  // Two councillors from two model families.
  // Invoke manually with @council -- auto-delegation is intentionally rare
  // (council is the highest-cost path: parallel model calls + synthesis).
  "council": {
    "default_preset": "default",
    "presets": {
      "default": {
        "claude": {
          "model": "anthropic/claude-sonnet-5",
          "prompt": "Focus on correctness, edge cases, and security implications."
        },
        "sol": {
          "model": "azure/gpt-6-sol",
          "prompt": "Focus on architecture, maintainability, and long-term design trade-offs."
        }
      }
    }
  },

  // ── Multiplexer ────────────────────────────────────────────────────────────
  // Opens each subagent in a live Herdr pane automatically.
  // Requires opencode launched with an explicit --port. Use the omos() zsh
  // helper from the multiplexer docs, or set OPENCODE_PORT before launching.
  "multiplexer": {
    "type": "herdr",
    "layout": "main-vertical"
  },

  // Disable anonymous PostHog telemetry.
  "telemetry": false
}
