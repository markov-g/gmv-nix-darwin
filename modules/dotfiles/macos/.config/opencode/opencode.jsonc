{
  "$schema": "https://opencode.ai/config.json",

  // Default model: Anthropic via Siemens proxy
  // $ANTHROPIC_DEFAULT_SONNET_MODEL = "claude-sonnet-4-6"
  "model": "anthropic/claude-sonnet-4-6",

  "provider": {
    "anthropic": {
      // Siemens proxy key ($ANTHROPIC_FOUNDRY_API_KEY).
      // If the proxy also requires a custom base URL, add:
      //   "options": { "baseURL": "https://<ANTHROPIC_FOUNDRY_RESOURCE>...." }
      "env": ["ANTHROPIC_FOUNDRY_API_KEY"]
    },
    "azure": {
      // Same endpoint as ~/.codex/config.toml
      "options": {
        "baseURL": "https://demo-building-claude-resource.openai.azure.com/openai/v1"
      },
      "env": ["AZURE_OPENAI_API_KEY"],
      "models": {
        "gpt-6-astra": {
          "id": "gpt-6-astra",
          "name": "GPT-6 Astra (Azure)"
        }
      }
    }
  }
}
