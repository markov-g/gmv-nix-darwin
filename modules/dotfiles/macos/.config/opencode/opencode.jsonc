{
  "$schema": "https://opencode.ai/config.json",

  // Default model: Claude via Siemens Azure AI Foundry (Anthropic Messages API).
  // CLAUDE_CODE_USE_FOUNDRY=1 signals that Claude is deployed on Azure, but the
  // wire format is the Anthropic Messages API -- use the anthropic provider, not azure.
  // The azure provider sends OpenAI Responses API requests which Claude rejects.
  "model": "anthropic/claude-sonnet-4-6",

  "provider": {
    "anthropic": {
      // API key: read from $ANTHROPIC_FOUNDRY_API_KEY (Siemens Azure key).
      "env": ["ANTHROPIC_FOUNDRY_API_KEY"],
      "options": {
        "baseURL": "https://{env:ANTHROPIC_FOUNDRY_RESOURCE}.services.ai.azure.com/anthropic/v1",
        "apiKey": "{env:ANTHROPIC_FOUNDRY_API_KEY}"
      }
    },
    "azure": {
      // GPT model via same Azure resource (OpenAI Responses API -- correct here).
      // Base URL constructed from $AZURE_RESOURCE_NAME (set externally).
      "env": ["AZURE_OPENAI_API_KEY"],
      "models": {
        "gpt-6-astra": {
          "id": "gpt-6-astra",
          "name": "GPT-6 Astra (Azure)"
        },
        "grok-4.6": {
          "id": "grok-4.6",
          "name": "Grok 4.6 (Azure)"
        }
      }
    }
  }
}
