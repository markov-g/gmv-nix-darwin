{
  "$schema": "https://opencode.ai/config.json",

  // ── Plugins ─────────────────────────────────────────────────────────────────
  // oh-my-opencode-slim: specialist agent pantheon (orchestrator, oracle,
  // explorer, librarian, designer, fixer, council) + herdr multiplexer panes.
  // Config: ~/.config/opencode/oh-my-opencode-slim.jsonc
  // Supersedes: oh-my-openagent.json (oh-my-openagent@4.15.1, never activated).
  //
  // Pinned (not floating on "latest"): single-maintainer project, fast-moving
  // config schema (the preset shape already changed once between versions).
  // autoUpdate would silently break agent-model overrides on a schema bump.
  // Renewal reminder: ~/bin/nix-update-all.sh checks this pin against npm's
  // latest dist-tag on every run (the update ritual you already do regularly)
  // and warns when it's stale -- no separate habit to remember. Before
  // bumping: diff oh-my-opencode-slim.schema.json against the pinned version,
  // then update this line AND the $schema line in oh-my-opencode-slim.jsonc.
  //
  // opencode-history-search (joeyism, MIT): read-only full-text/fuzzy/regex
  // search over OpenCode's own existing local session DB
  // (~/.local/share/opencode/opencode.db). Zero writes, zero network --
  // does not compete with Engram's curated memory (below); this is raw
  // conversation-history grep, a different category.
  //
  // opencode-direnv (simonwjackson, MIT): auto-loads .envrc env vars into the
  // OpenCode session at startup via `direnv export json`. direnv + nix-direnv
  // are already Nix-managed (home.nix) and hooked into every interactive
  // shell (.zprofile) -- this extends a trust boundary you've already
  // accepted, it does not introduce a new one. Graceful no-op if no .envrc
  // exists in the project. Note: .envrc is executable config -- `direnv
  // allow` approves arbitrary shell code to run on cd, and once loaded,
  // those env vars (potentially including secrets) become available to this
  // OpenCode session's MCP tools and subagents, same as any env var already
  // exported into an interactive shell today.
  "plugin": ["oh-my-opencode-slim@3.0.3", "opencode-history-search", "opencode-direnv"],

  // Default build model: GPT-6 Luna via Azure AI Foundry at max reasoning effort.
  // Note: azure provider uses OpenAI Responses API; anthropic provider uses
  // Anthropic Messages API -- do not mix them.
  "model": "azure/gpt-6-luna",

  // Plan mode uses Sonnet 5; build work uses the Luna workhorse above.
  "agent": {
    "plan": { "model": "anthropic/claude-sonnet-5" }
  },

  // Siemens brand dark theme (navy + teal accent palette).
  "theme": "siemens-brand",

  "autoupdate": false,
  "share": "disabled",

  // ── Context management ──────────────────────────────────────────────────────
  // Two coordinated pruning layers, not one "sole owner" -- documented honestly:
  //   1. DCP (dcp.jsonc): early, surgical -- dedup + purge-error-turns, triggers
  //      in the 35-70% context-fill window. First line of defense.
  //   2. Native compaction below: late, blanket fallback -- triggers at 92%
  //      fill if DCP's earlier pruning wasn't enough. Safety net, not the
  //      primary mechanism.
  // aggressive_truncation / truncate_all_tool_outputs were REMOVED (previously
  // enabled here): they truncated every tool output unconditionally, on every
  // call, regardless of context-fill position -- independent of and
  // uncoordinated with DCP's own dedup logic, which assumes it sees full
  // untruncated output to correctly identify duplicates. Running both meant
  // the same content could be lost twice via two mechanisms with no shared
  // log to attribute which one did it. Removing them closes that lossy
  // double-pruning path; DCP and native compaction's own budgets (35-70% /
  // 92%) are the two remaining, intentional layers.
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  },

  "experimental": {
    "preemptive_compaction_threshold": 0.92,
    "auto_resume": true,
    "task_system": true
  },

  // ── Providers ───────────────────────────────────────────────────────────────
  "provider": {
    // Primary: Claude via Siemens Azure AI Foundry (Anthropic Messages API).
    "anthropic": {
      "env": ["ANTHROPIC_FOUNDRY_API_KEY"],
      // Azure Foundry rates per MTok (input/output): Sonnet 5 $2/$10; Opus 5.5 $4/$20.
      // Cache hits per MTok: Sonnet 5 $0.20; Opus 5.5 omitted (supplied $0.40/$0.20 conflict).
      // Cache writes per MTok: Sonnet 5 $2.50 (5m) / $4 (1h); Opus 5.5 $5/$8 (duration labels conflict).
      "options": {
        "baseURL": "https://{env:ANTHROPIC_FOUNDRY_RESOURCE}.services.ai.azure.com/anthropic/v1",
        "apiKey": "{env:ANTHROPIC_FOUNDRY_API_KEY}"
      }
    },

    // Primary: GPT models via Azure AI Foundry (OpenAI Responses API).
    "azure": {
      "env": ["AZURE_OPENAI_API_KEY"],
      "models": {
        "gpt-6-astra": {
          "id": "gpt-6-astra",
          "name": "GPT-6 Astra (Azure)"
        },
        "gpt-6-sol": {
          "id": "gpt-6-sol",
          "name": "GPT-6 Sol (Azure)",
          "options": { "reasoningEffort": "high" }
        },
        // Azure rates per MTok (input/output): $2/$10.
        // Default workhorse model. Use maximum reasoning effort.
        "gpt-6-luna": {
          "id": "gpt-6-luna",
          "name": "GPT-6 Luna (Azure)",
          // Azure rates per MTok (input/output): $0.10/$0.50.
          "options": { "reasoningEffort": "max" },
          "variants": {
            "max": { "reasoningEffort": "max" }
          }
        },
      }
    },

    // Fallback: Siemens SDC LLM gateway (OpenAI-compatible).
    // Available to specialist agents in the Siemens preset.
    // Costs are unknown for Siemens-specific models (deepseek, qwen, glm-5).
    "siemens": {
      "npm": "@ai-sdk/openai-compatible",
      "env": ["SIEMENS_API_KEY"],
      "options": {
        "baseURL": "https://api.siemens.com/llm/v1",
        "apiKey": "{env:SIEMENS_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash (SDC)",
          "limit": { "context": 1048576, "output": 1048576 }
        },
        "gpt-oss-120b": {
          "id": "gpt-oss-120b",
          "name": "GPT OSS 120B (SDC)",
          "limit": { "context": 1024000, "output": 1024000 }
        },
        "qwen-3.6-27b": {
          "id": "qwen-3.6-27b",
          "name": "Qwen 3.6 27B (SDC)",
          "limit": { "context": 262144, "output": 262144 }
        },
        "ministral-3-14b-instruct-2512": {
          "id": "ministral-3-14b-instruct-2512",
          "name": "Ministral 3 14B (SDC)",
          "limit": { "context": 256000, "output": 256000 }
        },
        "glm-5-preview": {
          "id": "glm-5-preview",
          "name": "GLM-5 Preview (SDC)",
          "limit": { "context": 1000000, "output": 1000000 }
        }
      }
    }
  },

  // ── MCP servers ──────────────────────────────────────────────────────────────
  // NOTE: this object is deliberately left OPEN (no closing "}" for "mcp", no
  // final "}" for the file) -- home.nix splices in a closing block here, with
  // or without the "engram" entry depending on whether this host is listed in
  // modules/engram-hosts.nix. See home.nix's opencode.jsonc generation and
  // modules/dotfiles/macos/.config/opencode/opencode-engram-mcp-snippet.jsonc
  // for the part that gets conditionally appended.
  "mcp": {
    // Library/framework documentation lookup. Zero install -- remote, URL-only,
    // from OpenCode's own official docs examples.
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },

    // GitHub-wide code-pattern search via Vercel's grep.app. Zero install.
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
