{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "navy": "#000028",
    "navyDark": "#00001e",
    "navyLight": "#23233c",
    "midGray": "#565667",
    "lightGray": "#b3b3be",
    "warmWhite": "#f6f6f4",
    "white": "#ffffff",
    "teal": "#00cccc",
    "tealDark": "#00738a",
    "tealDeep": "#005159",
    "mint": "#00ffb9",
    "logoTeal": "#009999",
    "blue": "#6895f6",
    "blueDark": "#3664c6",
    "purple": "#805cff",
    "lavender": "#bfb0f3",
    "red": "#ff2640",
    "redDark": "#d72339",
    "redText": "#ff7687",
    "redTextDark": "#b81e31",
    "yellow": "#ffd732",
    "yellowDark": "#ebc93f",
    "green": "#01d65a",
    "greenDark": "#01893a",
    "cyan": "#00bedc",
    "cyanDark": "#007eb1",
    "focusBorder": "#1491eb",
    "softBdrDark": "#565667",
    "weakBdrDark": "#3a3a45",
    "softBdrLight": "#cccccc",
    "stdBdrLight": "#b3b3be",
    "softTextDark": "#999999",
    "weakTextDark": "#737373",
    "softTextLight": "#666675",
    "weakTextLight": "#9999a5",
    "diffAddBgDark": "#0a2a1a",
    "diffRemBgDark": "#2a0a14",
    "diffAddBgLight": "#e6f7ed",
    "diffRemBgLight": "#fde8ec",
    "diffCtxBgDark": "#1a1a2e",
    "diffCtxBgLight": "#f0f0ee"
  },
  "theme": {
    "primary": { "dark": "teal", "light": "tealDark" },
    "secondary": { "dark": "blue", "light": "blueDark" },
    "accent": { "dark": "mint", "light": "logoTeal" },
    "error": { "dark": "red", "light": "redDark" },
    "warning": { "dark": "yellow", "light": "yellowDark" },
    "success": { "dark": "green", "light": "greenDark" },
    "info": { "dark": "cyan", "light": "cyanDark" },
    "text": { "dark": "white", "light": "navy" },
    "textMuted": { "dark": "softTextDark", "light": "softTextLight" },
    "background": { "dark": "navy", "light": "warmWhite" },
    "backgroundPanel": { "dark": "navyLight", "light": "white" },
    "backgroundElement": { "dark": "navyLight", "light": "#ececea" },
    "border": { "dark": "softBdrDark", "light": "stdBdrLight" },
    "borderActive": { "dark": "teal", "light": "tealDark" },
    "borderSubtle": { "dark": "weakBdrDark", "light": "softBdrLight" },
    "diffAdded": { "dark": "green", "light": "greenDark" },
    "diffRemoved": { "dark": "red", "light": "redDark" },
    "diffContext": { "dark": "midGray", "light": "softTextLight" },
    "diffHunkHeader": { "dark": "blue", "light": "blueDark" },
    "diffHighlightAdded": { "dark": "mint", "light": "greenDark" },
    "diffHighlightRemoved": { "dark": "redText", "light": "redTextDark" },
    "diffAddedBg": { "dark": "diffAddBgDark", "light": "diffAddBgLight" },
    "diffRemovedBg": { "dark": "diffRemBgDark", "light": "diffRemBgLight" },
    "diffContextBg": { "dark": "diffCtxBgDark", "light": "diffCtxBgLight" },
    "diffLineNumber": { "dark": "midGray", "light": "lightGray" },
    "diffAddedLineNumberBg": { "dark": "diffAddBgDark", "light": "diffAddBgLight" },
    "diffRemovedLineNumberBg": { "dark": "diffRemBgDark", "light": "diffRemBgLight" },
    "markdownText": { "dark": "white", "light": "navy" },
    "markdownHeading": { "dark": "teal", "light": "tealDark" },
    "markdownLink": { "dark": "blue", "light": "blueDark" },
    "markdownLinkText": { "dark": "cyan", "light": "cyanDark" },
    "markdownCode": { "dark": "mint", "light": "tealDeep" },
    "markdownBlockQuote": { "dark": "softTextDark", "light": "softTextLight" },
    "markdownEmph": { "dark": "lavender", "light": "purple" },
    "markdownStrong": { "dark": "yellow", "light": "yellowDark" },
    "markdownHorizontalRule": { "dark": "midGray", "light": "lightGray" },
    "markdownListItem": { "dark": "teal", "light": "tealDark" },
    "markdownListEnumeration": { "dark": "cyan", "light": "cyanDark" },
    "markdownImage": { "dark": "blue", "light": "blueDark" },
    "markdownImageText": { "dark": "cyan", "light": "cyanDark" },
    "markdownCodeBlock": { "dark": "white", "light": "navy" },
    "syntaxComment": { "dark": "weakTextDark", "light": "weakTextLight" },
    "syntaxKeyword": { "dark": "blue", "light": "blueDark" },
    "syntaxFunction": { "dark": "teal", "light": "tealDark" },
    "syntaxVariable": { "dark": "cyan", "light": "cyanDark" },
    "syntaxString": { "dark": "green", "light": "greenDark" },
    "syntaxNumber": { "dark": "lavender", "light": "purple" },
    "syntaxType": { "dark": "mint", "light": "tealDeep" },
    "syntaxOperator": { "dark": "blue", "light": "blueDark" },
    "syntaxPunctuation": { "dark": "lightGray", "light": "midGray" }
  }
}
